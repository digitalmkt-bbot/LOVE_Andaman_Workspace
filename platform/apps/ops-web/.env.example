# Optional public API origin. Leave blank when `/v1` is reverse-proxied from the same domain.
# For a separate Railway service, set its public HTTPS origin (no trailing slash).
VITE_API_BASE_URL=https://your-api.up.railway.app

# Public Authentik OIDC configuration for the browser PKCE flow. No client secret.
VITE_AUTH_ISSUER=https://auth.example.com/application/o/provider-slug/
VITE_AUTH_CLIENT_ID=your-public-client-id
VITE_AUTH_REDIRECT_URI=https://your-ops-web.up.railway.app/auth/callback
