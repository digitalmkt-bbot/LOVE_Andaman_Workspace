{
  "name": "love-andaman-allotment",
  "version": "1.0.0",
  "private": true,
  "description": "LOVE Andaman · allotment_v2 ops app (static + cloud-sync via Postgres on Railway)",
  "scripts": {
    "start": "node server.js",
    "dev": "node --env-file=.env server.js",
    "safari": "node tools/safari-smoke.js",
    "ci:boot-smoke": "node tools/ci-boot-smoke.mjs",
    "dev:local": "node tools/dev-db.mjs run",
    "db:up": "node tools/dev-db.mjs up",
    "db:reset": "node tools/dev-db.mjs reset",
    "db:down": "node tools/dev-db.mjs down",
    "db:psql": "node tools/dev-db.mjs psql",
    "test:smoke": "node test/ui/t_smoke.mjs",
    "test:mobile": "node test/ui/t_mobile.mjs",
    "test:ui": "node test/ui/t_smoke.mjs && node test/ui/t_mobile.mjs",
    "test:embed": "node --test test/unit/embed-token.test.mjs && node test/ui/t_embed.mjs && node test/ui/t_embed_csp.mjs",
    "test:daydetail": "node test/ui/t_daydetail.mjs",
    "test:fleetcal": "node test/ui/t_fleetcal.mjs",
    "test:ovnmeal": "node test/ui/t_ovnmeal.mjs",
    "test:ratexp": "node test/ui/t_ratexp.mjs",
    "test:ratebind": "node test/ui/t_ratebind.mjs",
    "test:rtseason": "node test/ui/t_rtseason.mjs",
    "test:rtbulk": "node test/ui/t_rtbulk.mjs",
    "test:aginfo": "node test/ui/t_aginfo.mjs",
    "test:aghd": "node test/ui/t_aghd.mjs",
    "test:agprog": "node test/ui/t_agprog.mjs",
    "test:rtdup": "node test/ui/t_rtdup.mjs",
    "test:pjstale": "node test/ui/t_pjstale.mjs",
    "test:flboard": "node test/ui/t_flboard.mjs",
    "test:vbdrop": "node test/ui/t_vbdrop.mjs",
    "test:cklive": "node test/ui/t_cklive.mjs",
    "test:perm": "node test/ui/t_perm.mjs",
    "test:pjwb": "node test/ui/t_pjwb.mjs",
    "test:pjwbsave": "node test/ui/t_pjwbsave.mjs",
    "test:ssecatch": "node test/ui/t_ssecatch.mjs",
    "test:pjdone": "node test/ui/t_pjdone.mjs",
    "test:pckwb": "node test/ui/t_pckwb.mjs",
    "test:assetver": "node test/ui/t_assetver.mjs"
  },
  "dependencies": {
    "pg": "^8.13.1"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "playwright": "^1.61.1"
  }
}
