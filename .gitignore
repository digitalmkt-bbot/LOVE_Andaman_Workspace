# ── OS / editor junk ──
.DS_Store
*~
.~lock.*#
# FUSE orphans: deleting a file another process still has open on a FUSE mount (sshfs, NTFS-3G,
# gvfs, rclone…) renames it to .fuse_hiddenXXXX instead of unlinking, and an unclean unmount or a
# crashed holder leaves it there forever. One 3.2MB copy of allotment_v2.html rode along in the
# Initial commit this way and sat in every clone and worktree until 2026-08-27.
.fuse_hidden*

# ── Node ──
node_modules/
npm-debug.log*

# ── PRIVACY: real customer data + bulky backups — NEVER commit (esp. public repo) ──
allotment_v2/data_exports/
allotment_v2/BACKUP/
# The root BACKUP/ was NOT covered by the line above, so pre-edit copies were landing in history
# (7 server.js.bak_* are already tracked; a 5.1MB allotment_v2 HTML copy was one commit away on a
# 21MB repo). Ignore the directory itself + the loose root-level *.bak_<date>_<desc> files.
BACKUP/
*.bak
*.bak_*

# ── Env files (contain secrets) ──
.env
.env.*
!.env.example
allotment_v2/.env

# ── Local lock files ──
*.lock

# ── Temp / scratch files ──
*.tmp

# ── DB dumps ──
*.dump
*.sql.gz

# ── Build output ──
allotment_v2/dist/

# ── Attachment files (real customer docs — never commit) ──
restored_attachments/

# ── Claude Code local tooling (per-machine, not project code) ──
.agents/
.claude/
skills-lock.json

# real prod data pulled for dev seeding — never commit
os-backend/data_snapshots/
